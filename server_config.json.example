{
    "config_version": 1,
    "server": {
        "ip_mode": "auto",
        "manual_ip": "127.0.0.1",
        "port": 5000
    },
    "development": {
        "debug": false
    },
    "security": {
        "allow_registration": false,
        "session_expire_days": 7,
        "max_login_attempts": 5,
        "lockout_minutes": 10,
        "cookie_secure": false,
        "cookie_samesite": "lax"
    },
    "ui": {
        "default_theme": "blue"
    }
}
